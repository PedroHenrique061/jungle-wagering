{
  "name": "jungle-wagering",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "bun run src/main.ts",
    "dev": "bun --watch run src/main.ts",
    "typecheck": "tsc --noEmit",
    "test": "bun test tests/unit",
    "test:unit": "bun test tests/unit",
    "test:integration": "bun test tests/integration --timeout 60000",
    "test:concurrency": "bun test tests/concurrency --timeout 120000",
    "infra:up": "docker compose up -d postgres localstack",
    "infra:down": "docker compose down -v",
    "db:migrate": "bun run scripts/migrate.ts up",
    "db:rollback": "bun run scripts/migrate.ts down",
    "db:status": "bun run scripts/migrate.ts status",
    "db:reset": "bun run scripts/migrate.ts reset",
    "app:up": "docker compose --profile app up -d --build",
    "app:down": "docker compose --profile app down"
  },
  "dependencies": {
    "@aws-sdk/client-sqs": "^3",
    "@mikro-orm/core": "^6.4",
    "@mikro-orm/migrations": "^6.4",
    "@mikro-orm/nestjs": "^6.1",
    "@mikro-orm/postgresql": "^6.4",
    "@nestjs/common": "^11.0.0",
    "@nestjs/core": "^11.0.0",
    "@nestjs/platform-express": "^11.0.0",
    "prom-client": "^15",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@types/bun": "latest",
    "@types/express": "^5.0.0",
    "typescript": "^5.6.0"
  }
}
